{
  "id": null,
  "uid": "askmycrawl-service-job-manager",
  "title": "askmycrawl — job-manager",
  "description": "job-manager service — metrics, traces, and logs in one place. Kafka-only microservice (no HTTP surface, see backend/apps/job-manager/src/main.ts), so this drops the HTTP row service-auth.json/service-gateway.json have and replaces it with a Kafka row instead. Copy this file for a new service (see .claude/agents/devops.md's Grafana dashboard section).",
  "tags": ["askmycrawl", "otel", "service", "job-manager"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Messages consumed rate",
      "description": "job-requests + answer-ready combined — @opentelemetry/instrumentation-kafkajs's messaging.process metric.",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(otelcol_messaging_process_duration_count{job=\"job-manager\"}[$__rate_interval]))", "legendFormat": "msg/s" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 2, "type": "stat", "title": "Messages produced rate",
      "description": "crawl-frontier + job-created + result-saved combined — messaging.send metric.",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(otelcol_messaging_client_sent_messages_total{job=\"job-manager\"}[$__rate_interval]))", "legendFormat": "msg/s" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "p95 message processing time",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(otelcol_messaging_process_duration_bucket{job=\"job-manager\"}[$__rate_interval])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value" }
    },

    { "id": 101, "type": "row", "title": "Kafka", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 4, "type": "timeseries", "title": "Consume rate by topic",
      "description": "job-requests, answer-ready — the two topics job-manager consumes.",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (messaging_destination_name) (rate(otelcol_messaging_process_duration_count{job=\"job-manager\"}[$__rate_interval]))", "legendFormat": "{{messaging_destination_name}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Produce rate by topic",
      "description": "crawl-frontier (seed), job-created, result-saved — the three topics job-manager produces.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (messaging_destination_name) (rate(otelcol_messaging_client_sent_messages_total{job=\"job-manager\"}[$__rate_interval]))", "legendFormat": "{{messaging_destination_name}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Message processing time p95 by topic",
      "description": "No error/status label exists on this instrumentation's metrics (unlike HTTP's status_code) — a real gap, not an omission: a consumer-side failure shows up as an exception in the logs panel below, not as a labeled series here.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(otelcol_messaging_process_duration_bucket{job=\"job-manager\"}[$__rate_interval])))", "legendFormat": "{{messaging_destination_name}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "id": 102, "type": "row", "title": "Database (pg)", "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "DB query duration p95 by operation",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, db_operation_name) (rate(otelcol_db_client_operation_duration_seconds_bucket{job=\"job-manager\"}[$__rate_interval])))", "legendFormat": "{{db_operation_name}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "id": 103, "type": "row", "title": "Node runtime", "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 8, "type": "timeseries", "title": "Event loop delay (p50 / p99)",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "otelcol_nodejs_eventloop_delay_p50_seconds{job=\"job-manager\"}", "legendFormat": "p50" },
        { "expr": "otelcol_nodejs_eventloop_delay_p99_seconds{job=\"job-manager\"}", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "GC time by type",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (v8js_gc_type) (rate(otelcol_v8js_gc_duration_seconds_sum{job=\"job-manager\"}[$__rate_interval]))", "legendFormat": "{{v8js_gc_type}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "id": 104, "type": "row", "title": "Traces", "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 10, "type": "table", "title": "Recent traces",
      "description": "Click a Trace ID to open the full trace. @opentelemetry/auto-instrumentations-node's kafkajs instrumentation does produce real spans here (verified live: 'process job-requests'/'process answer-ready' root spans with 'send crawl-frontier'/'send job-created'/'send result-saved' children, plus pg child spans on the same trace) — confirmed before adding this panel, not assumed from the metric names existing. Deliberately a table, not the native 'traces' panel type — that panel doesn't auto-run its query on dashboard load/refresh in this Grafana version (confirmed: 0 requests fire until you manually re-enter the query in the panel editor), which makes it useless on a dashboard nobody's actively clicking into. A table with the same TraceQL query behaves like every other panel type and refreshes normally.",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "queryType": "traceql", "query": "{resource.service.name=\"job-manager\"}", "limit": 20, "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Start time", "desc": true }] }
    },

    { "id": 105, "type": "row", "title": "Logs", "gridPos": { "x": 0, "y": 50, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "id": 11, "type": "logs", "title": "Logs",
      "gridPos": { "x": 0, "y": 51, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=\"job-manager\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
