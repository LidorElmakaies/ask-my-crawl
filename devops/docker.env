# Shared container-network values, pulled in by every backend service's devops/<service>/docker-
# compose.yml via `env_file: - ../docker.env`. These override backend/.env's localhost-based local-
# dev defaults with the in-network hostname/port each dependency is actually reachable at once
# everything runs under `docker compose up` (container-to-container calls use the service name, not
# localhost) — see common.yml for why `../../backend/.env` loads first and this file loads second
# (later env_file entries win). No secrets here, just docker-compose-internal addresses, so unlike
# .env this file IS committed — nothing to fill in per-deployment.
#
# Not every service reads every var below — e.g. auth never touches Kafka, gateway never touches
# Postgres directly. An app that doesn't read a given var just ignores it; see
# backend/apps/<service>/.env.example for what a given service actually consumes.

KAFKA_BROKERS=kafka:19092
DATABASE_URL=postgres://postgres:postgres@postgres:5432/askmycrawl
REDIS_URL=redis://redis:6379
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
VECTOR_DB_URL=http://qdrant:6333
# LM Studio isn't containerized — host.docker.internal reaches back out to the host machine.
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1

# OpenTelemetry Collector — lives on the shared `observability` network (see the root docker-
# compose.yml's networks: block). OTEL_SERVICE_NAME is the one var that must stay unique per
# service, so it's NOT here — each service still sets it in its own `environment:` block.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
