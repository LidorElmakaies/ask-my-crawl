  "scripts": {
    "build:libs": "nest build auth-kernel && nest build dtos && nest build otel && nest build kafka-contracts && nest build kafka-client",
    "build:gateway": "npm run build:libs && nest build gateway && tsc-alias -p tsconfig.json",
    "build:auth": "npm run build:libs && nest build auth && tsc-alias -p tsconfig.json",
    "build:job-manager": "npm run build:libs && nest build job-manager && tsc-alias -p tsconfig.json",
    "build:scraper": "npm run build:libs && nest build scraper && tsc-alias -p tsconfig.json",
    "build:indexer": "npm run build:libs && nest build indexer && tsc-alias -p tsconfig.json",
    "build:query-answer": "npm run build:libs && nest build query-answer && tsc-alias -p tsconfig.json",
    "build": "npm run build:libs && nest build gateway && nest build auth && nest build job-manager && nest build scraper && nest build indexer && nest build query-answer && tsc-alias -p tsconfig.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest-integration.config.js --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config jest.config.js --runInBand",
    "test:e2e:gateway": "jest --config ./apps/gateway/test/jest-e2e.config.js",
    "test:e2e:auth": "jest --config ./apps/auth/test/jest-e2e.config.js",
    "test:e2e:job-manager": "jest --config ./apps/job-manager/test/jest-e2e.config.js",
    "test:e2e": "npm run test:e2e:gateway && npm run test:e2e:auth && npm run test:e2e:job-manager",
    "debug:crawl": "ts-node -r tsconfig-paths/register scripts/debug-crawl.ts"
  },
  "dependencies": {
