# Reference only — documents every env var the Gateway reads. Local dev still uses the single
# shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file from
# `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/gateway/docker-compose.yml's `env_file` + `environment:` overrides, not this file. Copy
# the lines below into backend/.env if you're filling it in var-by-var.

NODE_ENV=development

# HTTP + Socket.IO port. No code fallback env var name — just a plain default in main.ts.
PORT=8000

# JWT signing secret (backend/libs/auth-kernel) — Gateway verifies tokens locally (fast-fail) before
# forwarding to Auth Service, and RolesGuard reads the decoded role. Must match Auth Service's value
# exactly, see auth/.env.example.
JWT_SECRET=change-me-to-a-long-random-value

# job-created/result-saved Kafka consumers (src/realtime/). No code fallback — comma-separated if
# more than one broker.
KAFKA_BROKERS=localhost:9092

# Where the auth-proxy (src/auth-proxy/) forwards /auth/*, /me, /admin/users* to. No code fallback.
AUTH_SERVICE_URL=http://localhost:8001

# Where the jobs-proxy (src/jobs-proxy/) forwards GET /jobs* to. No code fallback.
JOB_MANAGER_URL=http://localhost:8002

# Admin-gated reverse-proxy targets (src/tool-proxy/, docs/planning/02-admin-dashboard-plan.md). No
# code fallback. docker-compose's observability/kafka-ui stacks don't publish these to the host by
# default (admin-only, reachable through the Gateway's proxy instead) — these values only work for a
# local (non-Docker) run if you separately publish Grafana's/kafka-ui's ports yourself.
GRAFANA_URL=http://localhost:3000
KAFKA_UI_URL=http://localhost:8080

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=gateway
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
