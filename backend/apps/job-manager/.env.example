# Reference only — documents every env var Job Manager Service reads. Local dev still uses the
# single shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file
# from `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/job-manager/docker-compose.yml's `env_file` + `environment:` overrides, not this file.
# Copy the lines below into backend/.env if you're filling it in var-by-var.

NODE_ENV=development

# Internal HTTP API port (GET /jobs*, forwarded to by the Gateway's jobs-proxy — not published to
# the host in docker-compose, cross-service traffic stays on the shared network). No code fallback
# env var name — just a plain default in main.ts.
PORT=8002

# job-requests/answer-ready consumers, crawl-frontier/job-created/result-saved producers. No code
# fallback — comma-separated if more than one broker.
KAFKA_BROKERS=localhost:9092

# Own Postgres connection (same physical `askmycrawl` instance Auth Service also uses, but each
# service owns only its own tables — docs/specs/data-model.md). Owns the `jobs` table.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=job-manager
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
