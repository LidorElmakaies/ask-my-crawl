# Reference only — documents every env var the Scraper reads. Local dev still uses the single
# shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file from
# `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/scraper/docker-compose.yml's `env_file` + `environment:` overrides, not this file. Copy
# the lines below into backend/.env if you're filling it in var-by-var.
#
# Kafka-only microservice — no HTTP surface, no PORT.

NODE_ENV=development

# crawl-frontier consumer (Frontier Consumer), crawl-frontier/page-scraped/crawl-complete producers
# (Scraper Worker). No code fallback — comma-separated if more than one broker.
KAFKA_BROKERS=localhost:9092

# Per-job dedup gate (Redis SADD) + BullMQ's `process-url` queue backing store. Shared with the
# Indexer's own Redis usage — one instance, see docs/specs/data-model.md.
REDIS_URL=redis://localhost:6379

# SeaweedFS's S3-compatible API — raw HTML blob storage, keyed by sha256(fragment-stripped url).
# Also read by devops/seaweedfs's own compose file to generate its S3 identity config, so every
# reader/writer agrees.
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=change-me-to-a-long-random-value
SEAWEEDFS_SECRET_KEY=change-me-to-a-different-long-random-value
SEAWEEDFS_BUCKET=askmycrawl-raw-html

# Max fetch attempts for transient failures (Scraper Worker, BullMQ retry/backoff); a permanent
# failure (4xx) never retries.
SCRAPER_FETCH_MAX_ATTEMPTS=3

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=scraper
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
