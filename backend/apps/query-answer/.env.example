# Reference only — documents every env var Query/Answer Service reads. Local dev still uses the
# single shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file
# from `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/query-answer/docker-compose.yml's `env_file` + `environment:` overrides, not this file.
# Copy the lines below into backend/.env if you're filling it in var-by-var.
#
# Kafka-only microservice — no HTTP surface, no PORT.

NODE_ENV=development

# crawl-complete consumer (Answer Intake Consumer, bridged onto BullMQ's `answer-job` queue),
# answer-ready producer (Answering Worker). No code fallback — comma-separated if more than one
# broker.
KAFKA_BROKERS=localhost:9092

# Own scoped copy of the Indexer's embedding client — embeds the job's query. Must match the
# Indexer's EMBEDDING_BASE_URL/EMBEDDING_MODEL/EMBEDDING_DIMENSION exactly (see
# indexer/.env.example), or retrieval breaks silently. Current default is a local LM Studio instance.
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=

# Own scoped read client — searches Qdrant directly for the top-k chunks filtered by job_id, no
# Indexer API in between (docs/specs/data-model.md). Must match the Indexer's VECTOR_DB_URL/
# VECTOR_DB_COLLECTION exactly.
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION=askmycrawl_chunks

# Chat LLM provider, any OpenAI-compatible /v1/chat/completions server. Current default is the same
# local LM Studio instance as EMBEDDING_BASE_URL, but must have a chat-capable model loaded, not
# just an embedding model. Swappable to a hosted provider with no code change. LLM_MODEL has no
# default — it must be the exact model name your provider has loaded; the service refuses to start
# without it.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=change-me
# LLM_API_KEY=

# The query is expanded into 3 variants (original + 2 LLM-generated rewrites, via LLM_BASE_URL/
# LLM_MODEL above — no separate config), each searched via both dense (Qdrant) and lexical
# (in-process BM25, no separate config either) retrieval. This is the per-variant, per-modality
# candidate pool pulled BEFORE RRF fusion trims it to FUSION_TOP_K_PER_MODALITY (5, not
# env-configurable) per modality — not the final chunk count handed to the LLM. Not tuned against
# real answer quality yet.
RETRIEVAL_TOP_K=15

# Max retries for transient failures, republished onto crawl-complete with backoff; a permanent
# failure never retries. A partial-failure crawl (succeeded_count/failed_count/failed_urls) is
# deliberately ignored — the answer comes purely from whatever chunks exist in Qdrant for the job.
ANSWER_MAX_RETRIES=5

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=query-answer
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
