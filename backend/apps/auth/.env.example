# Reference only — documents every env var Auth Service reads. Local dev still uses the single
# shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file from
# `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/auth/docker-compose.yml's `env_file` + `environment:` overrides, not this file. Copy the
# lines below into backend/.env if you're filling it in var-by-var.

NODE_ENV=development

# HTTP port. No code fallback env var name — just a plain default in main.ts.
PORT=8001

# JWT signing secret (backend/libs/auth-kernel) — Auth Service signs, Gateway verifies. Must match
# Gateway's value exactly, see gateway/.env.example.
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper — salt+pepper+SHA-256 per docs/specs/auth.md. Must stay identical across
# restarts or every existing password hash stops verifying.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# Own Postgres connection (same physical `askmycrawl` instance Job Manager Service also uses, but
# each service owns only its own tables — docs/specs/data-model.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl

# First-admin bootstrap — see docs/specs/auth.md. Leave both unset to skip seeding.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
