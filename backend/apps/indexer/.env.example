# Reference only — documents every env var the Indexer reads. Local dev still uses the single
# shared backend/.env.example → backend/.env (every app's ConfigModule reads that one file from
# `backend/`'s cwd, see root CLAUDE.md); Docker Compose supplies these via
# devops/indexer/docker-compose.yml's `env_file` + `environment:` overrides, not this file. Copy
# the lines below into backend/.env if you're filling it in var-by-var.
#
# Kafka-only microservice — no HTTP surface, no PORT.

NODE_ENV=development

# page-scraped consumer (Index Intake Consumer, bridged onto BullMQ's `index-page` queue),
# crawl-complete producer (Indexing Worker, once it observes both pending counters reach zero). No
# code fallback — comma-separated if more than one broker.
KAFKA_BROKERS=localhost:9092

# BullMQ's `index-page` queue backing store + own scoped copy of the coordination-store logic
# (docs/specs/data-model.md). Shared with the Scraper's own Redis usage — one instance.
REDIS_URL=redis://localhost:6379

# SeaweedFS's S3-compatible API — reads the raw HTML blob the Scraper wrote. Also read by
# devops/seaweedfs's own compose file to generate its S3 identity config, so every reader/writer
# agrees.
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=change-me-to-a-long-random-value
SEAWEEDFS_SECRET_KEY=change-me-to-a-different-long-random-value
SEAWEEDFS_BUCKET=askmycrawl-raw-html

# Max index attempts for transient failures (Indexing Worker, BullMQ retry/backoff); a permanent
# failure never retries.
INDEXER_MAX_ATTEMPTS=3

# Embedding provider, any OpenAI-compatible /v1/embeddings server. EMBEDDING_DIMENSION must match
# whatever's actually loaded. Current default is a local LM Studio instance. Query/Answer Service
# reads its own scoped copy of these same three vars — its values must match this app's exactly, or
# retrieval breaks silently (see query-answer/.env.example).
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=

# Vector DB connection (currently Qdrant, see devops/qdrant/docker-compose.yml) — the only writer.
# Query/Answer Service reads the same VECTOR_DB_URL/VECTOR_DB_COLLECTION values directly (no API in
# between, see docs/specs/data-model.md) — they must match exactly.
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION=askmycrawl_chunks

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per service.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=indexer
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
