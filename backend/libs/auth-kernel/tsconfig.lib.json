{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    // rootDir/outDir are pinned to the monorepo root (not this lib's folder) so the emitted tree
    // mirrors the source tree exactly: libs/auth-kernel/src/x.ts -> dist/libs/auth-kernel/src/x.js.
    // That 1:1 mapping is what lets `tsc-alias` rewrite `@app/*` requires into working relative
    // paths after the webpack build was dropped. Don't "simplify" this back to a per-lib outDir.
    "rootDir": "../..",
    "outDir": "../../dist",
    "tsBuildInfoFile": "../../dist/.tsbuildinfo-auth-kernel"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*spec.ts"]
}
