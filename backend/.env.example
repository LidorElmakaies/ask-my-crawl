# Copy to .env and fill in real values. Never commit .env itself.
# Shared across all backend apps when run locally (each app's ConfigModule reads the same file).
# No PORT here — each app defaults to its own port in code; override with a shell env var if needed.
#
# Each app under backend/apps/<name>/.env.example also documents just its own slice of the vars
# below, for a quick "what does this one service actually need" reference — those files are
# reference only, not a separate loading path; this file (→ backend/.env) is still what every
# app's ConfigModule actually reads locally, and what devops/<app>/docker-compose.yml's `env_file`
# points at for Docker Compose.

# Shared JWT signing secret — see docs/specs/auth.md.
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper — Auth Service only. Must stay identical across restarts.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# Shared Postgres connection. docker-compose overrides this to the in-network hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl

# First-admin bootstrap (Auth Service only) — see docs/specs/auth.md. Leave unset to skip.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# Gateway, Job Manager, Scraper, Indexer, Query/Answer — every Kafka producer/consumer. No code
# fallback: comma-separated if more than one broker. docker-compose overrides this to kafka:19092
# (the in-network listener); this is the host-published one, for local (non-Docker) runs.
KAFKA_BROKERS=localhost:9092

# Gateway only — where it proxies /auth/*, /me, /admin/users* to. No code fallback.
AUTH_SERVICE_URL=http://localhost:8001

# Gateway only — where it forwards GET /jobs* to. No code fallback.
JOB_MANAGER_URL=http://localhost:8002

# Gateway only — admin-gated reverse-proxy targets (docs/planning/02-admin-dashboard-plan.md). No
# code fallback. docker-compose's observability/kafka-ui stacks don't publish these to the host by
# default (admin-only, reachable through the Gateway's proxy instead) — these values only work for
# local (non-Docker) runs if you separately publish Grafana's/kafka-ui's ports yourself.
GRAFANA_URL=http://localhost:3000
KAFKA_UI_URL=http://localhost:8080

# Gateway only — Grafana JWT auth private key (docs/planning/05-grafana-jwt-auth.md).
GRAFANA_JWT_PRIVATE_KEY_FILE=./grafana-jwt-private.pem

# Scraper AND Indexer — Redis, one shared instance. Backs BullMQ + per-job coordination keys.
REDIS_URL=redis://localhost:6379

# Scraper AND Indexer — SeaweedFS's S3-compatible API. Also read by devops/seaweedfs's own
# compose file to generate its S3 identity config, so every reader/writer agrees.
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=change-me-to-a-long-random-value
SEAWEEDFS_SECRET_KEY=change-me-to-a-different-long-random-value
SEAWEEDFS_BUCKET=askmycrawl-raw-html

# Scraper only — max fetch attempts for transient failures; a permanent failure (4xx) never retries.
SCRAPER_FETCH_MAX_ATTEMPTS=3

# Indexer only — max index attempts for transient failures; a permanent failure never retries.
INDEXER_MAX_ATTEMPTS=3

# Indexer only — embedding provider, any OpenAI-compatible /v1/embeddings server. EMBEDDING_DIMENSION
# must match whatever's actually loaded. Current default is a local LM Studio instance.
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=

# Indexer only — vector DB connection (currently Qdrant, see devops/qdrant/docker-compose.yml).
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION=askmycrawl_chunks

# Query/Answer only — chat LLM provider, any OpenAI-compatible /v1/chat/completions server. Current
# default is the same local LM Studio instance as EMBEDDING_BASE_URL, but must have a chat-capable
# model loaded, not just an embedding model. LLM_MODEL has no default — it must be the exact model
# name your provider has loaded (unlike EMBEDDING_MODEL, there's no one common chat model to assume);
# the service refuses to start without it.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=change-me
# LLM_API_KEY=

# Query/Answer only — the user's query is expanded into 3 variants (original + 2 LLM-generated
# rewrites), each searched via both dense (Qdrant) and lexical (in-process BM25) retrieval; this is
# the per-variant, per-modality candidate pool pulled BEFORE RRF fusion trims it down to
# FUSION_TOP_K_PER_MODALITY (5, not env-configurable) per modality — not the final chunk count
# handed to the LLM. Not tuned against real answer quality yet.
RETRIEVAL_TOP_K=15

# Query/Answer only — max retries for transient failures, republished onto crawl-complete with
# backoff; a permanent failure never retries.
ANSWER_MAX_RETRIES=5

# Query/Answer also reads the existing EMBEDDING_*/VECTOR_DB_* vars above unchanged — its embedding
# client and Qdrant collection must match the Indexer's exact values, or retrieval breaks silently.

NODE_ENV=development

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per app.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
