# Copy to .env and fill in real values. Never commit .env itself.
# Shared across all backend apps when run locally (each app's ConfigModule reads the same file).
# No PORT here — each app defaults to its own port in code; override with a shell env var if needed.

# Shared JWT signing secret — see docs/specs/auth.md.
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper — Auth Service only. Must stay identical across restarts.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# Shared Postgres connection. docker-compose overrides this to the in-network hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl

# First-admin bootstrap (Auth Service only) — see docs/specs/auth.md. Leave unset to skip.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# Gateway only — where it proxies /auth/*, /me, /admin/users* to. Override for local (non-Docker) runs.
# AUTH_SERVICE_URL=http://localhost:8001

# Scraper AND Indexer — Redis, one shared instance. Backs BullMQ + per-job coordination keys.
REDIS_URL=redis://localhost:6379

# Scraper AND Indexer — SeaweedFS's S3-compatible API. Also read by devops/seaweedfs's own
# compose file to generate its S3 identity config, so every reader/writer agrees.
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=change-me-to-a-long-random-value
SEAWEEDFS_SECRET_KEY=change-me-to-a-different-long-random-value
SEAWEEDFS_BUCKET=askmycrawl-raw-html

# Scraper only — max fetch attempts for transient failures; a permanent failure (4xx) never retries.
SCRAPER_FETCH_MAX_ATTEMPTS=3

# Indexer only — max index attempts for transient failures; a permanent failure never retries.
INDEXER_MAX_ATTEMPTS=3

# Indexer only — embedding provider, any OpenAI-compatible /v1/embeddings server. EMBEDDING_DIMENSION
# must match whatever's actually loaded. Current default is a local LM Studio instance.
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
# EMBEDDING_API_KEY=

# Indexer only — vector DB connection (currently Qdrant, see devops/qdrant/docker-compose.yml).
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_COLLECTION=askmycrawl_chunks

NODE_ENV=development

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per app.
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to the Docker network address — set to localhost:4317 for a
# local (non-Docker) run, or telemetry export fails silently.
# OTEL_SERVICE_NAME=auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
