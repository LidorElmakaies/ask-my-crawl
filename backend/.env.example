# Copy to .env and fill in real values. Never commit .env itself.
# Shared across all backend apps when run locally from this directory (each app's ConfigModule
# reads the same file). No PORT here on purpose — each app defaults to its own port in code
# (gateway: 8000, auth: 8001) so running two apps locally at once doesn't collide; override
# with a real shell env var (`PORT=9000 npm run start:dev`) if you need something else.

# Shared JWT signing secret, via @app/auth-kernel. Gateway verifies; Auth Service signs +
# verifies. Per docs/specs/auth.md.
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper — Auth Service only. Per docs/specs/auth.md: never stored in the
# database, must stay identical across restarts or every existing password stops verifying.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# Shared Postgres connection, used by every service that owns Postgres tables. This default
# targets the `postgres` service in devops/docker-compose.yml when port-forwarded to localhost;
# docker-compose overrides this to the in-network hostname for container-to-container calls.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl

# First-admin bootstrap (Auth Service only) — see docs/specs/auth.md. Leave both unset to skip;
# safe to leave set permanently, it's a no-op once any admin exists.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# Gateway only — where it proxies /auth/*, /me, /admin/users* to (see docs/specs/services.md).
# Defaults to http://auth:8001 (the container service name) if unset; override for local
# (non-Docker) `npx nest start gateway --watch`, where that hostname won't resolve.
# AUTH_SERVICE_URL=http://localhost:8001

NODE_ENV=development

# OpenTelemetry — see backend/libs/otel. OTEL_SERVICE_NAME must be unique per app and match the
# name startOtel(...) is called with in that app's main.ts (gateway/auth). Left unset, it falls
# back to "unknown_service"/the value baked into the code — either works, but an explicit env var
# is what devops/docker-compose.yml sets, so keeping the same shape locally avoids surprises.
#
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to http://otel-collector:4317, which only resolves inside
# the Docker Compose network. Running an app locally (npx nest start <app> --watch, not compose) —
# either set this to http://localhost:4317 (with devops/observability's ports published, which
# they are by default) or expect telemetry export to fail. It fails silently by default; see
# backend/libs/otel's diag logging setup for how to see it fail instead.
# OTEL_SERVICE_NAME=auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
