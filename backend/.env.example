# Copy to .env and fill in real values. Never commit .env itself.
# Shared across all backend apps when run locally from this directory (each app's ConfigModule
# reads the same file). No PORT here on purpose — each app defaults to its own port in code
# (gateway: 8000, auth: 8001) so running two apps locally at once doesn't collide; override
# with a real shell env var (`PORT=9000 npm run start:dev`) if you need something else.

# Shared JWT signing secret, via @app/auth-kernel. Gateway verifies; Auth Service signs +
# verifies. Per docs/specs/auth.md.
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper — Auth Service only. Per docs/specs/auth.md: never stored in the
# database, must stay identical across restarts or every existing password stops verifying.
PASSWORD_PEPPER=change-me-to-a-different-long-random-value

# Auth Service's Postgres connection. This default targets the `postgres` service in
# devops/docker-compose.yml when port-forwarded to localhost; docker-compose overrides this
# to the in-network hostname for container-to-container calls.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/askmycrawl_auth

# First-admin bootstrap (Auth Service only) — see docs/specs/auth.md. Leave both unset to skip;
# safe to leave set permanently, it's a no-op once any admin exists.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

NODE_ENV=development
