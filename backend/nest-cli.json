{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "webpack": false,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "auth-kernel": {
      "type": "library",
      "root": "libs/auth-kernel",
      "entryFile": "index",
      "sourceRoot": "libs/auth-kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth-kernel/tsconfig.lib.json"
      }
    },
    "dtos": {
      "type": "library",
      "root": "libs/dtos",
      "entryFile": "index",
      "sourceRoot": "libs/dtos/src",
      "compilerOptions": {
        "tsConfigPath": "libs/dtos/tsconfig.lib.json"
      }
    },
    "otel": {
      "type": "library",
      "root": "libs/otel",
      "entryFile": "index",
      "sourceRoot": "libs/otel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/otel/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "indexer": {
      "type": "application",
      "root": "apps/indexer",
      "entryFile": "main",
      "sourceRoot": "apps/indexer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/indexer/tsconfig.app.json"
      }
    },
    "kafka-client": {
      "type": "library",
      "root": "libs/kafka-client",
      "entryFile": "index",
      "sourceRoot": "libs/kafka-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka-client/tsconfig.lib.json"
      }
    },
    "kafka-contracts": {
      "type": "library",
      "root": "libs/kafka-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/kafka-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka-contracts/tsconfig.lib.json"
      }
    },
    "job-manager": {
      "type": "application",
      "root": "apps/job-manager",
      "entryFile": "main",
      "sourceRoot": "apps/job-manager/src",
      "compilerOptions": {
        "tsConfigPath": "apps/job-manager/tsconfig.app.json"
      }
    },
    "scraper": {
      "type": "application",
      "root": "apps/scraper",
      "entryFile": "main",
      "sourceRoot": "apps/scraper/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scraper/tsconfig.app.json"
      }
    }
  }
}