# Reference only — documents the one env var the frontend reads (src/config/urls.js). Not meant to
# be copied to frontend/.env for local `npx expo start` — Expo Router's dev server needs it set as
# a real shell env var (Expo only inlines EXPO_PUBLIC_* at build/start time), and it falls back to
# the same localhost default below if unset. The Dockerized build (frontend/Dockerfile) bakes this
# in from devops/.env's PUBLIC_ORIGIN instead — see devops/.env.example, the single source of truth
# for the deployment's public origin; don't set this separately for that path.

# The Gateway's own origin — the frontend only ever talks to the Gateway, never a backend service
# directly (root CLAUDE.md's "frontend only ever talks to the Gateway" rule). Used for every
# HTTP/WS call: URLS.gateway.*, URLS.auth.origin, URLS.admin.*, URLS.jobs.* (see
# frontend/CLAUDE.md's "HTTP API"/"WebSocket" sections).
EXPO_PUBLIC_GATEWAY_ORIGIN=http://localhost:8000
